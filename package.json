{
  "name": "gritroom",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@vinext/cloudflare": "^1.3.3",
    "react": "latest",
    "react-dom": "latest",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.4.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.12",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-beta.28",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "^8.3.0",
    "wrangler": "^4.158.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "vite preview",
    "check": "cf workers types && tsc --noEmit && npm run build",
    "db:migrate": "wrangler d1 migrations apply gritroom-db --remote --config wrangler.d1.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply gritroom-db --local --config wrangler.d1.jsonc",
    "deploy": "npm run db:migrate && vinext-cloudflare deploy"
  }
}
